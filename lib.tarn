pub fn Client.llen(&mut self, key &string) Result<i64, Error> {
    packet := format_cmd_2(&"LLEN", key)
    resp := try self.execute(packet)
    match resp {
        RespVal.Integer(n) => return Ok(n)
        _ => return Ok(0)
    }
}

pub fn Client.lrange(&mut self, key &string, start i64, stop i64) Result<Vec<string>, Error> {
    start_str := string.from_i64(start)
    stop_str := string.from_i64(stop)
    packet := format_cmd_4(&"LRANGE", key, &start_str, &stop_str)
    resp := try self.execute(packet)
    var out: Vec<string> = Vec.new()
    match resp {
        RespVal.Array(arr) => {
            for it in arr.as_slice() {
                match it.as_string() {
                    Some(s) => out.push(s)
                    None => {}
                }
            }
        }
        _ => {}
    }
    return Ok(out)
}

